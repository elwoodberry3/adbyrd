# -----------------------------------------------------------------------------
# Adbyrd site environment variables
# Copy to .env.local for local work (never commit it). In production, set these
# in Vercel → Project → Settings → Environment Variables.
#
# NEXT_PUBLIC_* values are bundled into the browser. NEVER give a secret that prefix.
# -----------------------------------------------------------------------------

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://adbyrd.com

# ---- Inquiry pipeline (server-only, see ../automation/README.md) -------------
# Production n8n webhook URL for the "Adbyrd – Website Inquiry" workflow.
# Local testing: run `npm run mock:n8n` and use http://localhost:5678/webhook/adbyrd-inquiry
N8N_WEBHOOK_URL=
# Shared secret sent as the X-Adbyrd-Signature header. Must equal the value in
# the n8n credential "Adbyrd Webhook Header Auth". Generate with: openssl rand -hex 32
N8N_WEBHOOK_SECRET=

# Optional Cloudflare Turnstile. The widget renders only when the site key is
# set, and the server verifies tokens only when the secret is set. Set both or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Consent ------------------------------------------------------------------
# "opt-in" (default; nothing non-essential runs until accepted) or "opt-out"
NEXT_PUBLIC_CONSENT_MODE=opt-in

# ---- Google Business Profile ---------------------------------------------------
NEXT_PUBLIC_GBP_PROFILE_URL=
NEXT_PUBLIC_GBP_REVIEW_URL=

# ---- Tracking (nothing loads until an ID is set; see docs/TRACKING.md) --------
# Google Tag Manager (recommended). If set, configure GA4/Ads inside GTM and leave those two empty.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_LEAD_CONVERSION_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_BING_UET_ID=
# Vercel Web Analytics + Speed Insights are on by default; set to "false" to disable.
NEXT_PUBLIC_VERCEL_ANALYTICS=

# ---- Site verification tokens --------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=
NEXT_PUBLIC_PINTEREST_VERIFICATION=
